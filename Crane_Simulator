// joystick 
// pins vrx -> A0 
// pins vry -> A1
// SWitch -> pin 2
// +5V
// GND

// 1.3 SH1106 I2C OLED display 
// SCK -> SCL
// SDA -> SDA
// +3V
// GND

#include <Wire.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH1106.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET 4
Adafruit_SH1106 display(OLED_RESET);

const int VRx = A0;
const int VRy = A1;
const int SW = 2;

int xPosition = 0;
int yPosition = 0;
int SW_state = 0;

// Graphics bitmaps
const unsigned char cr0 [] PROGMEM = {0x38, 0x38, 0x44, 0x82, 0x82, 0xc6};
const unsigned char cr1 [] PROGMEM = {0x38, 0x38, 0x44, 0x44, 0x44, 0x6c};
const unsigned char box [] PROGMEM = {0xfe, 0x82, 0xaa, 0x92, 0xaa, 0x82, 0xfe};
const unsigned char jerab [] PROGMEM = {0x40, 0x04, 0xff, 0xfe, 0x40, 0x04, 0xf8, 0x3e, 0xff, 0xfe, 0xff, 0xfe, 0xff, 0xfe, 0xff, 0xfe, 0xff, 0xfe, 0xf9, 0x3e};
const unsigned char pas1 [] PROGMEM = {0x5b, 0x6d, 0xb6, 0xd8, 0xe0, 0x18, 0x0c, 0x00, 0xe0, 0x18, 0x0c, 0x00, 0x5b, 0x6d, 0xb6, 0xd8};
const unsigned char pas2 [] PROGMEM = {0x6d, 0xb6, 0xdb, 0x68, 0xe0, 0x18, 0x0c, 0x00, 0xe0, 0x18, 0x0c, 0x00, 0x6e, 0xdb, 0x6d, 0xb0};

byte pas = 0;
byte vrychlost = 1;
byte hrychlost = 2;
byte x = 63;
byte y = 25;
byte xbox = 20;
byte ybox = 56;

bool crane = false;
bool hold = false;
int i = 0;
bool flipflop = false;
int v = 0;

long lastDebounceTime = 0;
long debounceDelay = 200;

void setup() {
  display.begin(SH1106_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.display();

  pinMode(VRx, INPUT);
  pinMode(VRy, INPUT);
  pinMode(SW, INPUT_PULLUP);
}

void loop() {
  display.clearDisplay();

  // Conveyor animation
  if (pas <= 5) display.drawBitmap(98, 59, pas1, 29, 4, WHITE);
  else          display.drawBitmap(98, 59, pas2, 29, 4, WHITE);
  pas++;
  if (pas >= 10) pas = 0;

  // Joystick readings
  xPosition = analogRead(VRx);
  yPosition = analogRead(VRy);
  SW_state = digitalRead(SW);

  // Deadzone logic
  int deadzone = 50;
  int center = 512;

  if (xPosition < center - deadzone && x > hrychlost + 7) {
    x -= hrychlost;
  }
  else if (xPosition > center + deadzone && x < 128 - hrychlost - 8) {
    x += hrychlost;
    if (x >= 93 && y > 46) y = 46;
  }

  if (yPosition < center - deadzone && y > 22 + vrychlost) {
    y -= vrychlost;
  }
  if (yPosition > center + deadzone && y < 64 - vrychlost - 13 && x <= 93) {
    y += vrychlost;
  }
  if (yPosition > center + deadzone && y < 64 - vrychlost - 17 && x >= 94) {
    y += vrychlost;
  }

  // Button debouncing
  if ((millis() - lastDebounceTime) > debounceDelay && SW_state == LOW) {
    lastDebounceTime = millis();
    crane = !crane;
    if (hold) hold = false;
  }

  // Draw static elements
  display.setCursor(10, 0);
  display.print("CRANE SIMULATOR V3");
  display.drawFastHLine(0, 63, 128, WHITE); // Ground
  display.drawFastHLine(0, 11, 128, WHITE); // Overhead rail
  display.drawBitmap(x - 7, 10, jerab, 15, 10, WHITE); // Crane
  display.drawLine(x, 20, x, y, WHITE); // Cable

  // Triangle animation
  display.drawTriangle(102, 40 + v, 108, 40 + v, 105, 45 + v, flipflop ? WHITE : BLACK);
  flipflop = !flipflop;
  v++;
  if (v == 5) v = -v;

  // Crane clamp
  display.drawBitmap(x - 3, y, crane ? cr1 : cr0, 7, 6, WHITE);

  // Pick-up/drop logic
  if (!crane && x >= xbox && x <= xbox + 7 && y + 7 >= ybox) i++;
  else i--;
  i = constrain(i, 0, 10);

  if (crane && x >= xbox && x <= xbox + 7 && y + 7 >= ybox && i >= 1) hold = true;

  if (hold && crane) {
    xbox = x - 3;
    ybox = y + 6;
  }

  if (!hold) {
    if ((ybox < 56 && xbox < 94) || (ybox <= 52 && xbox >= 94)) ybox++;
    if (ybox >= 52 && xbox >= 94) {
      xbox++;
      if (xbox >= 150) {
        xbox = 10;
        ybox = 56;
      }
    }
  }

  display.drawBitmap(xbox, ybox, box, 7, 7, WHITE); // Load box
  display.display();
  delay(10); // Smooth animation
}
